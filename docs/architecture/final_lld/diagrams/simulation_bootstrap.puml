@startuml simulation_bootstrap
title SYNAPSE Phase 2 - Bootstrap & Orchestrator Detail

class HospitalSimulator {
    - clock: SimulationClock
    - scheduler: FutureActionScheduler
    - event_queue: EventQueue
    - dispatcher: EventDispatcher
    - state_manager: StateManager
    - rule_engine: RuleEngine
    - engine: SimulationEngine
    - kb: MedicalKnowledgeBase
    - coordinator: WorkflowCoordinator
    - journeys: List[PatientJourney]
    - metrics: dict
    + __init__(random_seed, start_time, enable_pubmed, pubmed_store_dir, offline_mode)
    + spawn_patients(patient_count: int): List[str]
    + run(until_time, max_events, output_dir): dict
}

class SimulationBootstrapFactory {
    + {static} bootstrap(sim, random_seed, start_time, enable_pubmed, pubmed_store_dir, offline_mode)
    + {static} wire_department_handlers(sim)
}

HospitalSimulator ..> SimulationBootstrapFactory : delegates __init__

@enduml
